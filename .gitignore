# Python cache
__pycache__/
*.py[cod]
.venv/
.env
.DS_Store

# GUI runtime state and local release output
.kara_gui_runs/
dist/

# Local models and caches
*.pt
*.pth
*.ckpt
*.safetensors

# Local pronunciation overrides
pronunciations.txt
**/pronunciations.txt

# Legacy root-level work files
i.txt
i_realign.txt
i.wav
i.mp3
i.flac
i.m4a
i.ogg
o.ass
o_*.ass
o_*.lrc
*_realign.txt
*.mp4

# Never publish root-level user songs or generated subtitles
/*.wav
/*.mp3
/*.flac
/*.m4a
/*.ogg
/*.aac
/*.jpg
/*.jpeg
/*.png
/*.ass
/*.lrc
/*.txt
!/requirements.txt
!/requirements-core.txt
!/requirements-gui.txt

# Per-song work folders
songs/*/*.txt
songs/*/*.wav
songs/*/*.mp3
songs/*/*.flac
songs/*/*.m4a
songs/*/*.ogg
songs/*/*.ass
songs/*/*.lrc
songs/*/*.mp4
songs/*/*.jpg
songs/*/*.png
songs/*/*.jpeg

# Keep checked-in song folder examples and docs
!songs/*/
!songs/*/README.md
!songs/*/.gitkeep
